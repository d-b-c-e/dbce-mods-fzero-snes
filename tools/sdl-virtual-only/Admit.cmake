# Shared configure/build admission. This script never runs the fixture.
get_filename_component(ISOLATED_ROOT "${SDL3_DIR}/.." ABSOLUTE)
file(READ "${CMAKE_CURRENT_LIST_DIR}/approved-admission.json" APPROVED)
file(READ "${ISOLATED_ROOT}/provenance.json" PROVENANCE)
string(JSON RUNTIME_ALLOWED GET "${PROVENANCE}" runtimeAllowed)
if(RUNTIME_ALLOWED)
  message(FATAL_ERROR "runtimeAllowed must remain false")
endif()
function(require_hash PATH EXPECTED)
  file(SHA256 "${PATH}" ACTUAL)
  string(TOUPPER "${ACTUAL}" ACTUAL)
  if(NOT ACTUAL STREQUAL EXPECTED)
    message(FATAL_ERROR "Isolated SDL hash mismatch: ${PATH}")
  endif()
endfunction()
foreach(KIND archive config)
  string(JSON PIN GET "${APPROVED}" ${KIND}SHA256)
  string(JSON RECORDED GET "${PROVENANCE}" ${KIND}SHA256)
  if(NOT PIN STREQUAL RECORDED)
    message(FATAL_ERROR "Isolated SDL ${KIND} provenance drift")
  endif()
endforeach()
string(JSON ARCHIVE GET "${PROVENANCE}" archivePath)
file(REAL_PATH "${ARCHIVE}" ARCHIVE)
if(NOT DEFINED RESOLVED_ARCHIVE)
  get_target_property(RESOLVED_ARCHIVE SDL3::SDL3-static IMPORTED_LOCATION_RELEASE)
endif()
file(REAL_PATH "${RESOLVED_ARCHIVE}" RESOLVED_ARCHIVE)
file(REAL_PATH "${SDL3_DIR}/libSDL3.a" LOCAL_ARCHIVE)
if(NOT RESOLVED_ARCHIVE STREQUAL ARCHIVE OR NOT ARCHIVE STREQUAL LOCAL_ARCHIVE)
  message(FATAL_ERROR "Isolated SDL link target drift")
endif()
string(JSON ACTUAL_HASH GET "${APPROVED}" archiveSHA256)
string(JSON ACTUAL_CONFIG GET "${APPROVED}" configSHA256)
require_hash("${ARCHIVE}" "${ACTUAL_HASH}")
set(CONFIG "${SDL3_DIR}/include-config-release/build_config/SDL_build_config.h")
require_hash("${CONFIG}" "${ACTUAL_CONFIG}")
string(JSON MANIFEST_HASH GET "${APPROVED}" manifestSHA256)
require_hash("${ISOLATED_ROOT}/source-sha256.txt" "${MANIFEST_HASH}")
file(STRINGS "${ISOLATED_ROOT}/source-sha256.txt" SOURCES)
set(EXPECTED_FILES)
foreach(LINE IN LISTS SOURCES)
  string(SUBSTRING "${LINE}" 0 64 PIN)
  string(SUBSTRING "${LINE}" 66 -1 RELATIVE)
  string(REPLACE "\\" "/" RELATIVE "${RELATIVE}")
  string(JSON PATCH_PIN ERROR_VARIABLE NO_PATCH GET "${APPROVED}" patchedSourceHashes "${RELATIVE}")
  if(NOT NO_PATCH)
    set(PIN "${PATCH_PIN}")
    string(JSON RECORDED GET "${PROVENANCE}" patchedSourceHashes "${RELATIVE}")
    if(NOT RECORDED STREQUAL PIN)
      message(FATAL_ERROR "Patched source provenance drift: ${RELATIVE}")
    endif()
  endif()
  require_hash("${ISOLATED_ROOT}/source/${RELATIVE}" "${PIN}")
  list(APPEND EXPECTED_FILES "${RELATIVE}")
endforeach()
file(GLOB_RECURSE ACTUAL_FILES LIST_DIRECTORIES false RELATIVE "${ISOLATED_ROOT}/source" "${ISOLATED_ROOT}/source/*")
list(SORT EXPECTED_FILES)
list(SORT ACTUAL_FILES)
if(NOT ACTUAL_FILES STREQUAL EXPECTED_FILES)
  message(FATAL_ERROR "Isolated SDL source file set drift")
endif()
file(STRINGS "${CONFIG}" MACROS REGEX "^#define SDL_JOYSTICK_[A-Za-z0-9_]+[ \t]+1$")
set(EXPECTED_MACROS "#define SDL_JOYSTICK_DUMMY 1;#define SDL_JOYSTICK_VIRTUAL 1")
list(SORT MACROS)
if(NOT MACROS STREQUAL EXPECTED_MACROS)
  message(FATAL_ERROR "Isolated SDL joystick macro allowlist mismatch")
endif()
file(READ "${SDL3_DIR}/compile_commands.json" COMMANDS)
string(JSON COUNT LENGTH "${COMMANDS}")
math(EXPR LAST "${COUNT}-1")
set(DRIVERS)
foreach(INDEX RANGE 0 ${LAST})
  string(JSON SOURCE GET "${COMMANDS}" ${INDEX} file)
  string(REPLACE "\\" "/" SOURCE "${SOURCE}")
  if(SOURCE MATCHES "/src/joystick/(.+)$")
    list(APPEND DRIVERS "${CMAKE_MATCH_1}")
  endif()
endforeach()
list(SORT DRIVERS)
set(ALLOWED "SDL_gamepad.c;SDL_joystick.c;SDL_steam_virtual_gamepad.c;controller_type.c;dummy/SDL_sysjoystick.c;virtual/SDL_virtualjoystick.c")
if(NOT DRIVERS STREQUAL ALLOWED)
  message(FATAL_ERROR "Isolated SDL joystick source allowlist mismatch")
endif()
message(STATUS "Isolated SDL admission passed; runtimeAllowed=false")

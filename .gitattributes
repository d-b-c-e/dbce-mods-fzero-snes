# Preserve exact pinned upstream license bytes across Windows checkouts.
licenses/fonts/*-OFL.txt text eol=lf
# Preserve the reviewed original provenance manifest byte-for-byte.
/lib/toolkit/source-to-binary-manifest.json -text
# Keep the reviewed ABI header's provenance hash stable across checkouts.
/vendor/dbce-shim/dbce_shim.h -text
/vendor/dbce-shim/dbce_shim_extras.h -text
# Preserve the unchanged toolkit frame-statistics header's raw provenance pin.
/src/vendor/panel/dbce_frame_stats.hpp -text
# Future archive exports only; tracked files and repository history stay intact.
/assets/img/boxart.tga export-ignore
/docs/screenshots export-ignore
/patches export-ignore
